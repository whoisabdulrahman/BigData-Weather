# ==============================================================================
# Bharat Weather Intelligence Platform (BWIP) — Environment Configuration
# ==============================================================================
# Security Notice: Do not commit actual secrets (.env) to version control.
# Copy this file to .env and adjust variables for your environment.

# ------------------------------------------------------------------------------
# General Platform Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PROJECT_NAME="National Weather Big Data Analytics Platform"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars-long
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PostgreSQL + PostGIS (Operational Database)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_platform
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_secure_dev_password
DATABASE_URL=postgresql://weather_user:weather_secure_dev_password@localhost:5432/weather_platform

# ------------------------------------------------------------------------------
# Redpanda / Kafka (Event Streaming)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=bwip-platform
KAFKA_TOPIC_RAW=weather.raw.v1
KAFKA_TOPIC_NORMALIZED=weather.normalized.v1
KAFKA_TOPIC_CLASSIFIED=weather.classified.v1
KAFKA_TOPIC_GEOLOCATED=weather.geolocated.v1
KAFKA_TOPIC_DEDUPED=weather.deduped.v1
KAFKA_TOPIC_VERIFIED=weather.verified.v1
KAFKA_TOPIC_INCIDENTS=weather.incidents.v1
KAFKA_TOPIC_ALERTS=weather.alerts.v1
KAFKA_TOPIC_DLQ=weather.dlq.v1

# ------------------------------------------------------------------------------
# Redis (Caching & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage (Media & Raw Artifacts)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MEDIA=weather-media
S3_BUCKET_RAW=weather-raw-payloads
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# External Data Providers (NW-041 WeatherAPI.com connector)
# Secrets go in .env only — never commit a real key.
# ------------------------------------------------------------------------------
WEATHERAPI_API_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_ENABLED=false
WEATHERAPI_TIMEOUT_SECONDS=10
# When false, benign sky conditions (Clear/Cloudy/Overcast) are counted but not
# ingested, so the incident table is not flooded with non-events.
WEATHERAPI_INCLUDE_BENIGN=false
# JSON array (or comma-separated list of names without commas).
WEATHERAPI_LOCATIONS=["New Delhi, India","Mumbai, India","Chennai, India","Kolkata, India","Bengaluru, India","Hyderabad, India"]

# ------------------------------------------------------------------------------
# Geocoding Provider (LocationIQ) — forward/reverse geocoding
# Keep the real key in .env only. Browser-exposed keys use the `pk.` prefix.
# ------------------------------------------------------------------------------
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
LOCATIONIQ_TIMEOUT_SECONDS=8
LOCATIONIQ_EMAIL=

# ------------------------------------------------------------------------------
# Map Rendering Provider (MapTiler) — vector tiles / style / sprites / glyphs
# This key is referrer-restricted, so it only works from the allowed origin
# (e.g. http://localhost:3000). Server-side calls from other hosts get 403.
# ------------------------------------------------------------------------------
MAPTILER_API_KEY=
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json

# ------------------------------------------------------------------------------
# Web Frontend (Next.js)
# NOTE: Next.js only reads env files inside apps/web/. Copy these values into
# apps/web/.env.local (gitignored) — the repo-root .env is invisible to Next.js.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_LOCATIONIQ_API_KEY=
